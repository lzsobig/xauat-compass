{
  "name": "xauat-compass",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node tools/build-cloudflare.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "trial": "node --env-file-if-exists=.env tools/trial.mjs",
    "report": "node --env-file-if-exists=.env tools/report.mjs",
    "build:offline": "node tools/build.mjs",
    "deploy": "wrangler deploy",
    "trial:cloud": "node tools/cloud-trial.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.147.0"
  }
}
